# Environment Configuration — copy to .env and fill in values
# NEVER commit .env to git

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gateway
GATEWAY_PORT=8000
GATEWAY_ENV=development   # development | production

# Upstream LLM (when replacing mock stream with real provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_BEDROCK_REGION=us-east-1

# Streamlit UI
GATEWAY_URL=http://localhost:8000
